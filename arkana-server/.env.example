# Arkana server configuration. Copy to .env and edit. Every variable is optional for a local run.

# Port of the API. Default 3001.
PORT=3001
# Interface the API listens on. Default 127.0.0.1 (behind a reverse proxy). Use 0.0.0.0 without a proxy.
HOST=127.0.0.1
# Set to "on" to also serve plain HTTP on port 80 (only without a reverse proxy). Off by default.
# ARKANA_BIND_80=on

# Jupiter API key from portal.jup.ag. The app reaches Jupiter through this server, which adds the key
# (it never ships in the app). Without it every phone shares the free tier's ~5 requests per 10 s.
# JUPITER_API_KEY=

# Mainnet RPC for payment checks, Seeker Genesis checks, the lookup table keeper and the RPC proxy. Default: public RPC.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# Second RPC used only for transaction status checks. Default: public mainnet RPC.
SOLANA_STATUS_RPC_URL=https://api.mainnet-beta.solana.com
# RPC for the admin ORE usage report (getProgramAccounts). Default: public mainnet RPC.
STATS_RPC_URL=https://api.mainnet-beta.solana.com

# Token for /api/admin/* (header x-admin-token or Authorization: Bearer). Admin endpoints return 404 when unset.
# At least 32 characters, e.g. `openssl rand -hex 32`; a shorter or placeholder value keeps the admin API disabled.
# ARKANA_ADMIN_TOKEN=

# Set to "off" to disable the Address Lookup Table keeper (it needs a funded keypair).
ARKANA_ALT_KEEPER=off
# Keypair file that pays rent for the lookup table. Default ~/.config/solana/id.json.
ARKANA_ALT_KEYPAIR=/path/to/lookup-table-authority.json

# Command that runs the LLM CLI inside the bubblewrap sandbox. Default /usr/local/bin/arkana-agy.
# If it is missing or fails, the built-in reading engine answers instead.
AGY_BIN=/usr/local/bin/arkana-agy

# Uncomment to accept API requests without a signed wallet session. LOCAL TESTING ONLY:
# with it anyone can spend any wallet's quota. The server logs a warning when it is set.
# ARKANA_REQUIRE_SESSION=off

# Daily SyncStake crank so ORE Stake yield reaches the tranches (paid by the ALT keypair). on | off
ARKANA_SYNC_KEEPER=off
# Hours between SyncStake runs
ARKANA_SYNC_INTERVAL_HOURS=24
