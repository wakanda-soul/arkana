# Arkana: HTTPS for arkana.icu (behind Cloudflare, SSL mode Full). Nothing is served on the bare IP.

arkana.icu, www.arkana.icu {
	encode gzip
	@www host www.arkana.icu
	redir @www https://arkana.icu{uri} permanent
	reverse_proxy 127.0.0.1:3001 {
		header_up X-Real-IP {http.request.header.CF-Connecting-IP}
	}
}

# Anything that is not arkana.icu (e.g. the bare IP): drop the connection
http:// {
	abort
}
