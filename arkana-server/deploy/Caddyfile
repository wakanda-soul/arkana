# Arkana: HTTPS for arkana.icu (behind Cloudflare, SSL mode Full). Nothing is served on the bare IP.

# Only Cloudflare may tell us the client IP; direct hits to the origin get their real TCP address
{
	# Admin API on a unix socket only Caddy (and root) can open, never on a TCP port
	admin unix//var/lib/caddy/admin.sock
	servers {
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers CF-Connecting-IP
	}
}

arkana.icu, www.arkana.icu {
	encode gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
	@www host www.arkana.icu
	redir @www https://arkana.icu{uri} permanent
	reverse_proxy 127.0.0.1:3001 {
		header_up X-Real-IP {client_ip}
	}
}

# Anything that is not arkana.icu (e.g. the bare IP): drop the connection
http:// {
	abort
}
