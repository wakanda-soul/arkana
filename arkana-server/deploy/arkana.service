[Unit]
Description=Arkana API server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Unprivileged service user; the code is read-only to it, only data/ and the AI home are writable
User=arkana
Group=arkana
WorkingDirectory=/srv/arkana/arkana-server
ExecStartPre=+/srv/arkana/arkana-server/deploy/arkana-net-guard.sh arkana
ExecStart=/opt/arkana-node/bin/node src/index.js
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
Environment=NODE_ENV=production
Environment=PORT=3001
Environment=HOME=/var/lib/arkana
Environment=PATH=/opt/arkana-node/bin:/usr/local/bin:/usr/bin:/bin
Environment=ARKANA_ALT_KEYPAIR=/etc/arkana/alt-keypair.json

# Hardening (bubblewrap for the AI sandbox needs unprivileged user namespaces, which stay allowed)
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
ReadWritePaths=/srv/arkana/arkana-server/data /var/lib/arkana-ai/home
CapabilityBoundingSet=
UMask=0077

[Install]
WantedBy=multi-user.target
